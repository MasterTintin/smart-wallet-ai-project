datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  transactions Transaction[] // 🔗 เพิ่มความสัมพันธ์ตรงนี้: User 1 คน มีได้หลายธุรกรรม
  aiInsights   AiInsight[]
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Decimal  @db.Decimal(12, 2)
  type        String
  category    String
  description String
  date        DateTime @default(now())
  userId      String   // 🔗 เก็บไอดีเจ้าของธุรกรรม
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade) // 🔗 ผูกติดกับตาราง User
}

model AiInsight {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  insightText String
  createdAt   DateTime @default(now())
}